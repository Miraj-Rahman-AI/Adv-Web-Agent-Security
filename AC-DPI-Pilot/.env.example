# ==========================================
# AC-DPI-PILOT CONFIGURATION
# ==========================================

# Local Ollama service base address.
# Configure a different address only when required.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model
OLLAMA_MODEL=qwen3.5:4b

# Cross-model evaluation
OLLAMA_MODELS=qwen3.5:4b,gemma3:4b

# Inference settings
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_PREDICT=384
OLLAMA_TIMEOUT=240

# Random seed
AC_DPI_SEED=42

# Default repetitions
AC_DPI_REPETITIONS=10

# Results directory
AC_DPI_RESULTS_DIR=results

# Remote HTTP endpoints are disabled by default.
AC_DPI_ALLOW_INSECURE_REMOTE=false
